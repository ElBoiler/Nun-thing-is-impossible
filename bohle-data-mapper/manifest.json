{
  "manifest_version": 3,
  "name": "Bohle Datenmapper",
  "short_name": "Datenmapper",
  "version": "0.1.0",
  "description": "Überträgt Daten aus PDF- oder Excel-Dateien regelbasiert in eine Excel-Vorlage. Alles lokal im Browser.",
  "minimum_chrome_version": "116",
  "offline_enabled": true,
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Bohle Datenmapper öffnen",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "permissions": ["storage"]
}
